# ═══════════════════════════════════════════════════════════
# Campaign Autopilot — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copie para .env e preencha com suas chaves
# cp .env.example .env
# ATENÇÃO: .env está no .gitignore — NUNCA commitar chaves!

# ═══════════════════════════════════════════════════════════
# 🏆 LLM PROVIDERS (pelo menos UM para gerar texto)
# ═══════════════════════════════════════════════════════════
OPENROUTER_API_KEY=               # [sua chave] → openrouter.ai/keys (200+ modelos free)
GROQ_API_KEY=                     # [sua chave] → console.groq.com/keys (Llama 3 70B free)
GEMINI_API_KEY=                   # [sua chave] → aistudio.google.com/apikey (Gemini Flash free)

# ═══════════════════════════════════════════════════════════
# 🖼️ IMAGE GENERATION (já funciona sem chave: Pollinations.ai)
# ═══════════════════════════════════════════════════════════
# ✅ Pollinations.ai — Grátis, sem chave, já funciona (imagens via URL)
#    https://image.pollinations.ai/prompt/...?width=1200&height=630
#
# Opcionais (free tier, melhora qualidade):
REPLICATE_API_KEY=               # r8_... → replicate.com/account/api-tokens (FLUX.1)
DEEPAI_API_KEY=                  # DeepAI image gen (free tier, sem cartão)
PRODIA_API_KEY=                  # Prodia SDXL (free tier, sem cartão)
HF_API_KEY=                      # HuggingFace Inference (aumenta rate limit)

# ═══════════════════════════════════════════════════════════
# 🔊 ÁUDIO — TTS (já funciona: gTTS + edge-tts)
# ═══════════════════════════════════════════════════════════
# ✅ gTTS — Google TTS, grátis, sem chave, 52 idiomas
# ✅ edge-tts — Microsoft Neural TTS, grátis, sem chave, vozes naturais

# ═══════════════════════════════════════════════════════════
# 🔗 AFILIADOS — PRINCIPAIS FONTES DE RENDA
# ═══════════════════════════════════════════════════════════
KIWIFY_AFFILIATE_ID=             # ID do afiliado → kiwify.com.br
EDUZZ_AFFILIATE_ID=              # ID do afiliado → eduzz.com
MONETIZZE_AFFILIATE_ID=          # ID do afiliado → monetizze.com.br
HOTMART_CLIENT_ID=               # Client ID → app.hotmart.com (Integrações → API)
HOTMART_CLIENT_SECRET=           # Client Secret do Hotmart
AMAZON_ASSOCIATES_TAG=           # Tracking ID → associe.amazon.com.br
MERCADOLIVRE_AFFILIATE_ID=         # ID do afiliado -> mercadolivre.com.br/afiliados
SHOPEE_AFFILIATE_ID=               # ID do afiliado -> shopee.com.br/afiliados
SHEIN_AFFILIATE_ID=                # ID do afiliado -> shein.com/afiliados
ALIEXPRESS_AFFILIATE_ID=           # ID do afiliado -> aliexpress.com/afiliados

# ═══════════════════════════════════════════════════════════
# 🌐 WORDPRESS — PUBLICAÇÃO AUTOMÁTICA (opcional)
# ═══════════════════════════════════════════════════════════
WP_URL=                          # https://seudominio.com
WP_USER=                         # Usuário admin
WP_PASSWORD=                     # Senha do WordPress

# ═══════════════════════════════════════════════════════════
# 🔊 ÁUDIO (opcional, Kokoro TTS)
# ═══════════════════════════════════════════════════════════
KOKORO_VOICE=af_heart            # Voz padrão (af_heart, af_bella, etc.)

# ═══════════════════════════════════════════════════════════
# ⚙️ SISTEMA
# ═══════════════════════════════════════════════════════════
MONEY_LOOP_INTERVAL=24           # Horas entre ciclos do Money Loop
MONEY_LOOP_NICHES=1              # Número de nichos por ciclo
CAMPAIGN_BOT_REQUIRE_OPT_IN=false# Se true, só executa com opt-in explícito

# 🔐 DASHBOARD (opcional, se vazio fica público)
DASHBOARD_PASSWORD=              # Senha para acessar o dashboard Streamlit
