{
  "name": "production_workflow",
  "description": "🏭 WORKFLOW DE PRODUÇÃO COMPLETO — 9 canais de tráfego orgânico. Concorrência → SEO → Conteúdo → 9 Canais → Site → Receita. Máquina completa de monetização orgânica sem tráfego pago.",
  "max_workers": 14,
  "steps": [
    {
      "id": "competitor_analysis",
      "agent": "competitor_analysis",
      "depends_on": [],
      "description": "Analisar concorrentes e encontrar gaps de conteúdo.",
      "deps": []
    },
    {
      "id": "seo_scraper",
      "agent": "seo_scraper",
      "depends_on": [],
      "description": "Dados reais de SEO do Google.",
      "deps": []
    },
    {
      "id": "compliance",
      "agent": "compliance",
      "depends_on": [],
      "description": "Validar compliance do conteúdo e ofertas.",
      "deps": []
    },
    {
      "id": "memory_lookup",
      "agent": "memory_lookup",
      "depends_on": [],
