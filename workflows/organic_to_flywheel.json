  "workflow_id": "organic_to_flywheel",
  "max_workers": 6,
  "entry_points": [
    "parallel_revenue",
    "flywheel_decision",
    "google_ads_campaign",
    "meta_ads_campaign",
    "native_ads_campaign",
    "performance_report"
  ]
